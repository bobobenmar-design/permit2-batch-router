# Copy this file to .env and keep the real values local and secret.
# Never commit any real keys or RPC URLs to source control.

NODE_ENV=development
PORT=3003

# Public RPC or Alchemy provider used by the backend relayer.
ALCHEMY_API_KEY=REPLACE_WITH_REAL_ALCHEMY_KEY
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/REPLACE_WITH_REAL_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/REPLACE_WITH_REAL_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_WITH_REAL_KEY

# Relayer wallet used by the backend to broadcast transactions.
# This key must be stored only in local .env and guarded with strict permissions.
RELAYER_PRIVATE_KEY=0xREPLACE_WITH_YOUR_RELAYER_PRIVATE_KEY

# Permit2 and router addresses.
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
BATCH_ROUTER_ADDRESS=0xREPLACE_WITH_DEPLOYED_ROUTER_ADDRESS

# Token addresses to monitor and process automatically.
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDC_ADDRESS=0xA0b86991c6218b36caa5c7d2d0b0d5f8d8f7b4d0

# Optional runtime tuning.
MONITOR_INTERVAL_MS=60000
LOG_LEVEL=info

# Optional known owner or admin wallet for notifications or enforcement.
OWNER_WALLET_ADDRESS=0xREPLACE_WITH_OWNER_WALLET
