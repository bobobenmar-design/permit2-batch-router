{
  "name": "permit2-batch-router",
  "version": "1.0.0",
  "main": "script/ScanAndSign.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix frontend/trust-wallet-companion run dev -- --host 0.0.0.0 --port 4174",
    "dev:server": "node -e \"process.env.PORT='3003'; import('./server/index.js')\"",
    "build": "npm --prefix frontend/trust-wallet-companion run build",
    "scan": "tsx script/ScanAndSign.ts",
    "deploy:sepolia": "forge script script/Deploy.s.sol:DeployBatchTokenTransferRouter --rpc-url sepolia --broadcast"
  },
  "dependencies": {
    "alchemy-sdk": "^3.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.21.2",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
